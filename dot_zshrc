# ==============================================================================
# Oh My Zsh Configuration
# ==============================================================================

export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="robbyrussell"

# Custom prompt styling: cyan current directory, new line, bold/color indicator
PROMPT='%F{cyan}%~%f\n%# '

# Shell plugins list
plugins=(git)

# Load Oh My Zsh frameworks
source $ZSH/oh-my-zsh.sh

# ==============================================================================
# Environment Variables & $PATH Setup
# ==============================================================================

# Ensure local binaries take precedence
export PATH="$HOME/.local/bin:$PATH"
export PATH="$HOME/.cargo/bin:$PATH"
export PATH="$PATH:$HOME/.npm-global/bin"

# Go development environment paths
if command -v go &> /dev/null; then
    export PATH="$PATH:$(go env GOPATH)/bin"
fi


# Preferred default editor
export EDITOR="zeditor"

# ==============================================================================
# Aliases & Custom Tools Configuration
# ==============================================================================

# Load syntax highlighting plugin if installed via system package manager
if [ -f "/usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" ]; then
    source /usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
fi
